# Rendered by scripts/cluster-up.sh, which substitutes __REPO_ROOT__ and writes to .local/.
# The kind CLI creates this cluster. Terraform does not. See docs/adr/0002-cluster-creation.md.
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
name: plane-platform
nodes:
  - role: control-plane
    image: kindest/node:v1.36.4@sha256:099e049362a1526b2db71494e1947aae99bd16290d7c895f2b7ea312e3cbfaed
    extraPortMappings:
      # Loopback only. kind defaults to 0.0.0.0, which would expose unauthenticated UIs to the LAN.
      - { containerPort: 30080, hostPort: 80, listenAddress: 127.0.0.1, protocol: TCP }
      - { containerPort: 30443, hostPort: 443, listenAddress: 127.0.0.1, protocol: TCP }
    extraMounts:
      # Registry mirror config, present before containerd pulls anything.
      - hostPath: __REPO_ROOT__/infrastructure/kind/containerd-certs.d
        containerPath: /etc/containerd/certs.d
        readOnly: true
      # Backups live on the host so they survive cluster deletion.
      - hostPath: __REPO_ROOT__/.local/backups
        containerPath: /backups
