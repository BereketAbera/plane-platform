     "showLegend": false
    },
    "tooltip": {
     "mode": "single"
    }
   },
   "targets": [
    {
     "expr": "min by (namespace, probe) (probe_success{namespace=~\"plane-.*\"})",
     "legendFormat": "{{namespace}} {{probe}}",
     "range": true,
     "instant": false,
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
   ],
   "description": "When each environment was reachable. Green is up, red is down."
  },
  {
