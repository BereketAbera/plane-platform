    {
     "expr": "sum by (env) (label_replace(rate(traefik_service_requests_total{service=~\"plane-(dev|prod-sim)-.*\",code=~\"5..\"}[5m]), \"env\", \"$1\", \"service\", \"plane-(dev|prod-sim)-.*\")) / sum by (env) (label_replace(rate(traefik_service_requests_total{service=~\"plane-(dev|prod-sim)-.*\"}[5m]), \"env\", \"$1\", \"service\", \"plane-(dev|prod-sim)-.*\"))",
     "legendFormat": "{{env}}",
     "range": true,
     "instant": false,
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     }
    }
