# Local tooling and machine state. Nothing here is ever committed.
/.tools/
/.local/
/.build/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
*.auto.tfvars
*.auto.tfvars.json
!*.example.auto.tfvars
terraform.tfvars
terraform.tfvars.json
!terraform.tfvars.example

# Secrets, dumps, and backups must never enter Git
*.env
!*.env.example
*.pem
*.key
*.dump
*.sql
*.sql.gz

# Build outputs
node_modules/
.DS_Store
