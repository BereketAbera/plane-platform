                      return hs
                
                  params:
                    # Traefik reaches the server over plain HTTP. The CLI needs --grpc-web --plaintext.
                    server.insecure: true
                    # Rendering kube-prometheus-stack is the memory spike, so cap concurrent renders under the 512Mi limit.
                    reposerver.parallelism.limit: 2
                
                dex:
                  enabled: false
                
                notifications:
                  enabled: false
                
                # The chart has no enable switch for this one. Zero replicas runs no pod and pulls nothing, so this limit costs
                # nothing. It was never measured: it exists so the Deployment still names one, as policy/charts.rego asks.
                applicationSet:
                  replicas: 0
                  resources:
                    requests:
                      cpu: 10m
                      memory: 32Mi
                    limits:
                      memory: 128Mi
                
                # Memory below totals 360Mi requests and 1792Mi limits for the four running pods. Peaks measured on the
                # first real run, with monitoring and Infisical synced and no Plane workloads yet: controller 517Mi,
                # repo-server 247Mi, server 83Mi, redis 25Mi.
                # No CPU limits anywhere: throttling a controller on a laptop only slows the first sync.
                controller:
                  replicas: 1
                  # A Service only. tests/network-policy-matrix.yaml dials it, and the ServiceMonitor that selects it
                  # lives in monitoring/manifests/shared, so the chart's own serviceMonitor stays off.
                  metrics:
                    enabled: true
                  resources:
                    requests:
                      cpu: 100m
                      memory: 192Mi
                    # 768Mi left 37Mi of room: cgroup memory.peak reached 731Mi with Plane running (2026-11-04), and an OOM kill
                    # here stalls every sync. 1024Mi is that peak plus 40%. It only moves the ceiling: no GOMEMLIMIT is set, so
                    # the heap sizes itself the same way, and the namespace has no ResourceQuota to fit.
                    limits:
                      memory: 1024Mi
                  # Upstream ships this off because restarting an overloaded controller makes things worse
                  # (argo-cd#9557). On because a wedged controller here would otherwise hang silently, with
                  # thresholds slack enough (5 min) that first-sync load alone should not trip it.
                  livenessProbe:
                    enabled: true
                    initialDelaySeconds: 60
                    periodSeconds: 30
                    timeoutSeconds: 5
                    failureThreshold: 10
                
                repoServer:
                  replicas: 1
                  # Upstream's own manifest at v3.5.7 sets false. The chart defaults to true.
                  automountServiceAccountToken: false
                  serviceAccount:
                    automountServiceAccountToken: false
                  # A Service only, as for the controller.
                  metrics:
                    enabled: true
                  resources:
                    requests:
                      cpu: 50m
                      memory: 96Mi
                    # Peak 247Mi (cgroup memory.peak) with all 8 chart Applications hard-refreshed at once and
                    # reposerver.parallelism.limit at 2, so this has room.
                    limits:
                      memory: 512Mi
                
                server:
                  replicas: 1
                  # A Service only, as for the controller.
                  metrics:
                    enabled: true
                  resources:
                    requests:
                      cpu: 25m
                      memory: 48Mi
                    limits:
                      memory: 192Mi
                
                redis:
                  image:
                    # The chart defaults to ecr-public.aws.com. Same index digest on docker.io, which the node
                    # pulls through the pull-through cache (contract section 5).
                    repository: docker.io/library/redis
                    tag: 8.6.4-alpine@sha256:2cc044fc5a07c9b701f8f1255a309ae9ad7856e694ac03513bf3648c01e40763
                  automountServiceAccountToken: false
                  resources:
                    requests:
                      cpu: 10m
                      memory: 24Mi
                    limits:
                      memory: 64Mi
                  # The chart ships both off.
                  readinessProbe:
                    enabled: true
                    initialDelaySeconds: 5
                    periodSeconds: 10
                    timeoutSeconds: 5
                  livenessProbe:
                    enabled: true
                    initialDelaySeconds: 30
                    periodSeconds: 15
                    timeoutSeconds: 5
                
                # Helm hook that generates the Redis password into Secret argocd-redis at install time.
                redisSecretInit:
                  resources:
                    requests:
                      cpu: 10m
                      memory: 32Mi
                    limits:
                      memory: 192Mi
            EOT,
        ]
