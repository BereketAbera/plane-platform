                      if available == nil then
                        return hs
                      end
                      if available.status == "True" then
                        hs.status = "Healthy"
                        hs.message = "All instances are available"
                      elseif reconcile_failure ~= nil then
                        hs.status = "Degraded"
                        hs.message = reconcile_failure.message or reconcile_failure.reason
                      elseif available.reason == "NoPodReady" or available.reason == "SomePodsNotReady" then
                        hs.message = available.reason .. ": " .. (available.message or "")
                      else
                        hs.status = "Degraded"
                        hs.message = available.message or available.reason
                      end
