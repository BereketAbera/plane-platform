                    url: http://argocd.localhost
                
                    # Argo CD removed this check in 1.8, so without it a child reports no health and the root's
                    # waves pass straight through. Base text from docs/operator-manual/health.md at v3.5.7.
                    # A non-hook task waits on anything except Healthy and Degraded (sync_context.go), so Missing
                    # and Progressing hold the wave, while Degraded fails the root sync and the root's retry reruns it.
                    #
                    # The base text alone does not gate. controller/health.go skips hooks and resources not created
                    # yet, so a child reads Healthy between its own waves and through its migrator. Healthy also needs:
                    # - No .operation. It clears only when an operation completes (setOperationState), so this covers
                    #   requested, running, retrying and terminating. With retry limit -1 a failing child never ends.
                    # - Synced. status.health is only as new as the last refresh. A one-wave child's sync succeeds on
                    #   apply, so at that moment it can still show a Healthy computed with objects absent, and that
                    #   same refresh recorded OutOfSync. The post-sync refresh then corrects both.
                    # Cost: a child that stays OutOfSync holds every later wave. `make up` needs all 14 Synced anyway.
                    resource.customizations.health.argoproj.io_Application: |
                      hs = {}
                      hs.status = "Progressing"
                      hs.message = ""
                      if obj.status ~= nil then
                        if obj.status.health ~= nil and obj.status.health.status ~= nil then
                          hs.status = obj.status.health.status
                          if obj.status.health.message ~= nil then
                            hs.message = obj.status.health.message
                          end
                        end
                        if hs.status == "Healthy" then
                          if obj.operation ~= nil then
                            hs.status = "Progressing"
                            hs.message = "Holding the wave: child sync has not finished"
                          elseif obj.status.sync == nil or obj.status.sync.status ~= "Synced" then
                            hs.status = "Progressing"
                            hs.message = "Holding the wave: child is Healthy but not Synced"
                          end
                        end
                      end
                      return hs
                
                    # Argo CD's built-in check (resource_customizations/monitoring.coreos.com/Prometheus/health.lua at v3.5.7)
