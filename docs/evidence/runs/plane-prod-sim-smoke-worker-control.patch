+        while self.cluster.queues().get("celery", {}).get("consumers", 0) < 1:
+            if time.monotonic() > end:
+                raise StepFailed("the replacement worker has no consumer on queue celery after 120s")
+            time.sleep(2)
+        data["worker_replaced"] = True
