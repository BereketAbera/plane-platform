+    def replace_worker(self, data: dict) -> None:
+        """cancel_consumer empties Celery's queue selection, and add_consumer attaches a consumer without
+        putting the queue back in it. Such a worker runs normally until its next broker reconnect. It then
+        builds its consumer from the empty selection and consumes nothing, while inspect ping still answers.
+        A new pod has a clean selection, and deleting a pod is no drift for Argo CD."""
+        self.cluster.in_namespace("delete", "pod", "-l", "app.kubernetes.io/component=worker", "--wait=true",
