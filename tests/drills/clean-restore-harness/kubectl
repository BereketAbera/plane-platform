        if ren:
            m = {
                "plane-pgdb": {"POSTGRES_USER": "PG_USER", "POSTGRES_PASSWORD": "PG_PASSWORD", "POSTGRES_DB": "PG_DB"},
                "plane-rabbitmq": {"RABBITMQ_DEFAULT_USER": "RABBITMQ_USER", "RABBITMQ_DEFAULT_PASS": "RABBITMQ_PASSWORD"},
                "plane-doc-store": {"MINIO_ROOT_USER": "SILO_ACCESS_KEY", "MINIO_ROOT_PASSWORD": "SILO_SECRET_KEY", "AWS_ACCESS_KEY_ID": "SILO_ACCESS_KEY", "AWS_SECRET_ACCESS_KEY": "SILO_SECRET_KEY"},
                "plane-app-keys": {"SECRET_KEY": "SECRET_KEY", "LIVE_SERVER_SECRET_KEY": "LIVE_SERVER_SECRET_KEY"},
                "plane-app-env": {"DATABASE_URL": "PG_PASSWORD"},
                "plane-live-env": {"REDIS_URL": "PG_DB"},
            }
            if name in m:
                data = {k: ren[v] for k, v in m[name].items() if v in ren}
                # What a scenario says differs from Infisical: lines of namespace, Secret, key.
                for line in state_text("rendered-tamper").splitlines():
                    t_ns, t_name, t_key = line.split()
                    if t_ns == ns and t_name == name and t_key in data:
                        data[t_key] += "-differs"
    if data is None:
        print(f'secret "{name}" not found', file=sys.stderr)
        sys.exit(NOT_FOUND)
    print(json.dumps({"metadata": {"name": name, "annotations": {}}, "data": {k: b64(v) for k, v in data.items()}}))
