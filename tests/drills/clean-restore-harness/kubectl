if args[0] == "apply":
    doc = sys.stdin.read()
    kind = (re.search(r"^kind: (\S+)", doc, re.M) or [None, "?"])[1]
    name = (re.search(r"^  name: (\S+)", doc, re.M) or [None, "?"])[1]
    target = (re.search(r"^  namespace: (\S+)", doc, re.M) or [None, ns])[1]
    if kind == "Secret":
        data = {m.group(1): base64.b64decode(m.group(2)).decode() for m in re.finditer(r"^  (\w+): (\S+)$", doc.split("\ndata:", 1)[1], re.M)}
        if target == "infisical":
            cl.setdefault("zero", {})[name] = data
            cl["infisical_pvc"] = True
        if name == "plane-infisical-identity":
            cl.setdefault("identities", {})[target] = data["identityId"]
            log(f"kc publish identity ns={target} id={data['identityId']}")
        jsave("cluster.json", cl)
        sys.exit(0)
    if kind == "Job":
        log(f"kc apply Job {re.sub(r'-[0-9]{8}t[0-9]{6}z$', '', name)} ns={target}")
        jobs = jload("jobs.json", {})
        state = "Complete"
        if any(f in name and (not fl or fl in str(target)) for f, fl in jload("fail-jobs.json", [])):
            state = "Failed"
        if any(f in name and (not fl or fl in str(target)) for f, fl in jload("hang-jobs.json", [])):
            state = "Running"
        if target == "infisical" and name.startswith("plane-restore-") and "guard" not in name and cl.get("infisical_migrating"):
            log("ERROR the database was replaced while the fresh server was still migrating")
        # The migrator's Job is made from the rendered one, and keeps its labels.
        label = "plane-backup" if name.startswith("plane-backup") else ("plane-ce" if "migrate" in name else "plane-restore")
        jobs[name] = {"state": state, "ns": target, "label": label}
        jsave("jobs.json", jobs)
        if name.startswith("plane-backup") and state == "Complete":
            subprocess.run([sys.executable, os.path.join(STUBS, "fakejob.py"), doc], check=True)
        if name.startswith("plane-restore-migrate") and state == "Complete":
            if apps_up(target):
                log(f"ERROR the migrator of {target} ran with its apps still up")
            cl.setdefault("needs_migrate", {}).pop(target, None)
            jsave("cluster.json", cl)
        # A Job left running has not got to the end yet, and one that is removed never does.
        if name.startswith("plane-restore-") and "guard" not in name and "migrate" not in name and state == "Complete":
            if target == "infisical":
                if workloads().get("infisical/infisical", 1) > 0:
                    log("ERROR the database was replaced with the Infisical server still up")
                # The dump comes back: the fake API serves what the backup recorded once the server restarts.
                bid = re.search(r'name: BACKUP_ID, value: "([^"]+)"', doc).group(1)
                with open(f"{ROOT}/.local/backups/infisical/{bid}/fake-api-dump.json") as f:
                    jsave("restored-pending", json.load(f))
            elif target and target.startswith("plane-"):
                if any(workloads().get(f"{target}/{d}", 1) > 0 for d in PLANE_APPS):
                    log(f"ERROR the database of {target} was replaced with its apps still up")
                bid = re.search(r'name: BACKUP_ID, value: "([^"]+)"', doc).group(1)
                with open(f"{ROOT}/.local/backups/{env_of(target)}/{bid}/postgres/rowcounts.tsv") as f:
                    counts = dict(line.rstrip("\n").split("\t") for line in f)
                cl.setdefault("users", {})[target] = int(counts.get("users", 0))
                with open(f"{ROOT}/.local/backups/{env_of(target)}/{bid}/manifest.json") as f:
                    cl.setdefault("objects", {})[target] = json.load(f)["objects"]["count"]
                cl.setdefault("needs_migrate", {})[target] = True
                jsave("cluster.json", cl)
        sys.exit(0)
    log(f"kc apply {kind} {name}")
    sys.exit(0)

if args[0] == "delete":
    if args[1] == "job":
        jobs = jload("jobs.json", {})
        jobs.pop(args[2], None)
        jsave("jobs.json", jobs)
        log(f"kc delete job {re.sub(r'-[0-9]{8}t[0-9]{6}z$', '', args[2])} ns={ns}")
    sys.exit(0)

print("stub kubectl: unhandled: " + cmd, file=sys.stderr)
sys.exit(99)
