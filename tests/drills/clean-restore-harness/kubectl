#!/usr/bin/env python3
"""Stub kubectl for tests/drills/clean-restore-harness.sh. Just enough of the API, with its state in $H_STATE.

It keeps the state a real cluster would keep, and reads it back, so the scripts see what they did:
Deployments have replicas, pods exist only while replicas are above zero, Applications read Synced and Healthy
only when what they own matches Git, self-heal reverts a scale unless auto-sync is paused, and a rendered Secret
holds what the fake Infisical holds, once that environment's identity is published. Anything it has no answer
for exits 99, so a new call in a script shows up as a failure and not as a quiet success.

A scenario can make it fail as a broken API does: $H_STATE/kubectl-fail holds one regular expression per line, matched
against the namespace and the command, and a line that starts with once: is used up by its first match.
What must never happen is logged as a line starting ERROR, and S1 and others look for those.
"""
import base64, json, os, re, subprocess, sys, time

S = os.environ["H_STATE"]
ROOT = os.environ["H_ROOT"]
STUBS = os.environ["H_STUBS"]


def log(line):
    with open(f"{S}/calls.log", "a") as f:
        f.write(line + "\n")


def jload(name, default):
    try:
        with open(f"{S}/{name}") as f:
            return json.load(f)
    except FileNotFoundError:
        return default


def jsave(name, data):
    with open(f"{S}/{name}.tmp", "w") as f:
        json.dump(data, f)
    os.replace(f"{S}/{name}.tmp", f"{S}/{name}")


a = sys.argv[1:]
ns = None
args = []
i = 0
while i < len(a):
    if a[i] == "--context":
        i += 2
        continue
    if a[i] == "-n":
        ns = a[i + 1]
        i += 2
        continue
    if a[i].startswith("--namespace"):
        if "=" in a[i]:
            ns = a[i].split("=")[1]
            i += 1
        else:
            ns = a[i + 1]
            i += 2
        continue
    if a[i].startswith("--request-timeout"):
        i += 1
        continue
    args.append(a[i])
    i += 1

cl = jload("cluster.json", {"exists": False})
if not cl.get("exists") or cl.get("stopped"):
    print("The connection to the server was refused", file=sys.stderr)
    sys.exit(1)
cmd = " ".join(args)


def asked_to_fail():
    path = f"{S}/kubectl-fail"
    if not os.path.exists(path):
        return False
    with open(path) as f:
        lines = f.read().splitlines()
    for i, line in enumerate(lines):
        once = line.startswith("once:")
        pattern = line[5:] if once else line
        if pattern and re.search(pattern, f"{ns or ''} {cmd}"):
            if once:
                del lines[i]
                with open(path, "w") as f:
                    f.write("\n".join(lines) + "\n")
            return True
    return False


if asked_to_fail():
    log(f"kc failed, as the scenario asked: {ns or ''} {cmd}")
    print("Unable to connect to the server: net/http: TLS handshake timeout", file=sys.stderr)
    sys.exit(1)
# A call that does not answer until something stops it, as a wedged API does. One regular expression, matched as above,
# and only once, because what runs after the stop must not hang on the same thing. A second line, if any, is what
# calls.log must hold by then, for a call that a script makes more than once.
if os.path.exists(f"{S}/kubectl-hang"):
    with open(f"{S}/kubectl-hang") as f:
        hang = f.read().splitlines() + ["", ""]
    with open(f"{S}/calls.log") as f:
        so_far = f.read()
    if hang[0] and re.search(hang[0], f"{ns or ''} {cmd}") and re.search(hang[1], so_far):
        os.remove(f"{S}/kubectl-hang")
        log(f"kc hung, as the scenario asked: {ns or ''} {cmd}")
        time.sleep(600)
api = jload("api.json", {})
b64 = lambda s: base64.b64encode(s.encode()).decode()
PLANE_APPS = ["plane-api-wl", "plane-worker-wl", "plane-beat-worker-wl", "plane-live-wl"]
NOT_FOUND = 1


def workloads():
    return cl.setdefault("workloads", {})


def app_for(namespace, name):
    if namespace == "infisical" and name == "infisical":
        return "infisical"
    if namespace in ("plane-dev", "plane-prod-sim"):
        return namespace
    return None


def paused(app):
    return cl.setdefault("paused", {}).get(app, False)


def env_of(namespace):
    return namespace.replace("plane-", "")


def rendered(env):
    """What the operator would render for an environment: nothing until its identity is published."""
    if f"plane-{env}" not in cl.get("identities", {}) or not api.get("initialized"):
        return None
    project = api.get("project_ids", {}).get(env)
    secrets = api.get("projects", {}).get(project)
    return {k: v["value"] for k, v in secrets.items()} if secrets else None


def app_status(name):
    if name == "infisical":
        ok = "infisical-secrets" in cl.get("zero", {}) and workloads().get("infisical/infisical") == 1
        return ("Synced", "Healthy") if ok else ("OutOfSync", "Progressing")
    if name in ("plane-dev", "plane-prod-sim"):
        if rendered(env_of(name)) is None:
            return ("OutOfSync", "Degraded")
        ok = all(workloads().get(f"{name}/{d}", 1) == 1 for d in PLANE_APPS)
        return ("Synced", "Healthy") if ok else ("OutOfSync", "Progressing")
    return ("Synced", "Healthy")


def app_names():
    names = ["root"]
    for f in sorted(os.listdir(f"{ROOT}/gitops/applications")):
        with open(f"{ROOT}/gitops/applications/{f}") as fh:
            for m in re.finditer(r"^kind: Application\nmetadata:\n  name: (\S+)", fh.read(), re.M):
                names.append(m.group(1))
    return names


def app_object(name):
    auto = {"prune": True, "selfHeal": True}
    if paused(name):
        auto["enabled"] = False
    sync, health = app_status(name)
    return {
        "metadata": {"name": name},
        "spec": {"syncPolicy": {"automated": auto}},
        "status": {"sync": {"status": sync}, "health": {"status": health}, "operationState": {"phase": "Succeeded"}},
    }


def running_restore_jobs(namespace=None):
    """Restore Jobs still changing data, in one namespace or any. A guard only reads, so it does not count."""
    return [n for n, j in jload("jobs.json", {}).items()
            if j["state"] == "Running" and n.startswith("plane-restore-") and "guard" not in n and (namespace is None or j.get("ns") == namespace)]


def apps_up(namespace):
    return any(workloads().get(f"{namespace}/{d}", 1) > 0 for d in PLANE_APPS)


def state_text(name, default=""):
    try:
        with open(f"{S}/{name}") as f:
            return f.read()
    except FileNotFoundError:
        return default


def server_image():
    try:
        with open(f"{S}/server-image") as f:
            return f.read().strip()
    except FileNotFoundError:
        with open(f"{ROOT}/helm/values/infisical.yaml") as f:
            text = f.read()
        repo = re.search(r"^\s*repository: (\S*infisical\S*)", text, re.M).group(1)
        tag = re.search(r'^\s*tag: "?([^"\s]+)', text, re.M).group(1)
        return f"{repo}:{tag}"


