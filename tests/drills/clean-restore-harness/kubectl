if args[0] == "get" and args[1] == "pods":
    # Pods go away a read or two after the scale that ended them, so a script has to wait for it.
    selector = next((x for x in args if "=" in x or " in " in x), "")
    if "infisical-standalone" in selector:
        keys = ["infisical/infisical"]
    elif "component in" in selector:
        keys = [f"{ns}/{d}" for d in PLANE_APPS]
    else:
        keys = []
    alive = [k for k in keys if workloads().get(k, 1) > 0]
    lingering = cl.setdefault("lingering", {})
    going = [k for k in keys if lingering.get(k, 0) > 0]
    for k in going:
        lingering[k] -= 1
    jsave("cluster.json", cl)
    for k in alive + going:
        print("pod/" + k.split("/")[1] + "-0")
    sys.exit(0)

if args[0] == "get" and args[1] == "jobs":
    jobs = jload("jobs.json", {})
    items = []
    for name, state in jobs.items():
        if state.get("ns") != ns:
            continue
        status = {"active": 1} if state["state"] == "Running" else {("failed" if state["state"] == "Failed" else "succeeded"): 1, "conditions": [{"type": state["state"], "status": "True"}]}
        items.append({"metadata": {"name": name, "labels": {"app.kubernetes.io/name": state.get("label", "")}}, "status": status})
    selector = next((x for x in args if x.startswith("app.kubernetes.io/name=")), None)
    if selector:
        want = selector.split("=")[1]
        items = [i for i in items if i["metadata"]["labels"]["app.kubernetes.io/name"] == want]
    print(json.dumps({"items": items}))
