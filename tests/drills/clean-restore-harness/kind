#!/usr/bin/env python3
"""Stub kind for tests/drills/clean-restore-harness.sh. A new cluster is empty, and its Infisical boots uninitialized."""
import json, os, re, sys

S = os.environ["H_STATE"]


def jload(name, default):
    try:
        with open(f"{S}/{name}") as f:
            return json.load(f)
    except FileNotFoundError:
        return default


def jsave(name, data):
    with open(f"{S}/{name}.tmp", "w") as f:
        json.dump(data, f)
    os.replace(f"{S}/{name}.tmp", f"{S}/{name}")


def log(line):
    with open(f"{S}/calls.log", "a") as f:
        f.write(line + "\n")


def read(name, default):
    try:
        with open(f"{S}/{name}") as f:
            return f.read().strip()
    except FileNotFoundError:
        return default


cl = jload("cluster.json", {"exists": False})
if sys.argv[1:3] == ["get", "clusters"]:
    if cl.get("exists"):
        print("plane-platform")
    sys.exit(0)
if sys.argv[1:3] == ["delete", "cluster"]:
    jsave("cluster.json", {"exists": False, "generation": cl.get("generation", 1)})
    jsave("jobs.json", {})
    log("kind delete cluster")
    # What the host gets back, if this scenario tracks free disk. See stubs df and docker.
    if os.path.exists(f"{S}/free-kib"):
        m = re.match(r"([0-9.]+)GB", read("kind-volume-size", "12.22GB"))
        back = float(m.group(1)) * 1e9 / 1024 * int(read("reclaim-percent", "93")) / 100
        now = int(read("free-kib", "0")) + int(back)
        with open(f"{S}/free-kib", "w") as f:
            f.write(str(now))
    sys.exit(0)
if sys.argv[1:3] == ["create", "cluster"]:
    log("kind create cluster")
    if cl.get("exists"):
        print("the cluster exists", file=sys.stderr)
        sys.exit(1)
    jsave("cluster.json", {"exists": True, "generation": cl.get("generation", 0) + 1, "workloads": {"infisical/infisical": 1}})
    jsave("jobs.json", {})
    api = jload("api.json", {})
    api.update(initialized=False, tokens=[], projects={}, password="")
    jsave("api.json", api)
    with open(f"{S}/tf-scenario", "w") as f:
        f.write("update")
    sys.exit(0)
if sys.argv[1:3] == ["export", "kubeconfig"]:
    sys.exit(0)
print("stub kind: unhandled", sys.argv[1:], file=sys.stderr)
sys.exit(99)
