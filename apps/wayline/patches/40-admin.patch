+
+// A fictional course, from the first waypoint to the last.
+const COURSE = [
+  { id: "ORIGN", x: 84, y: 636 },
+  { id: "KNOLL", x: 244, y: 462 },
+  { id: "SADLE", x: 428, y: 418 },
+  { id: "HAVEN", x: 586, y: 182 },
+];
+const COURSE_POINTS = COURSE.map(({ x, y }) => `${x},${y}`).join(" ");
+
+const diamond = (x: number, y: number, r: number) => `M${x} ${y - r}L${x + r} ${y}L${x} ${y + r}L${x - r} ${y}Z`;
+
+export function AuthAside() {
+  return (
+    <aside data-wl-auth="chart" data-wl-admin-aside>
+      <svg viewBox="0 0 720 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
+        <rect className="wl-c-paper" width="720" height="1000" />
+        {CONTOURS.map((d, i) => (
+          <path key={d.slice(0, 24)} className={i % 4 === 2 ? "wl-c-index" : "wl-c-minor"} d={d} />
+        ))}
+        <polyline className="wl-c-halo" points={COURSE_POINTS} />
+        <polyline className="wl-c-route" points={COURSE_POINTS} />
+        {COURSE.map(({ id, x, y }, i) => {
+          if (i === 0) return <circle key={id} className="wl-c-ring" cx={x} cy={y} r={9} />;
+          if (i === COURSE.length - 1) return <path key={id} className="wl-c-wpt-end" d={diamond(x, y, 13)} />;
+          return <path key={id} className="wl-c-wpt" d={diamond(x, y, 8)} />;
+        })}
+        <g className="wl-c-text wl-c-text-wpt">
+          {COURSE.map(({ id, x, y }) => (
+            <text key={id} x={x + 20} y={y + 4}>
+              {id}
+            </text>
+          ))}
+        </g>
+      </svg>
+      <div data-wl-admin-legend>
+        <PlaneLockup height={24} width={115} className="text-primary" />
+        <p className="text-h5-medium text-primary">Chart the course for this instance.</p>
+        <p className="text-body-sm-regular text-secondary">
+          Workspaces, authentication, email and AI settings for everyone on this deployment.
+        </p>
+      </div>
+    </aside>
+  );
+}
+
+// A plain anchor: /source sits outside this app's /god-mode/ basename, so a router link would miss it.
+export function AuthCredit() {
+  return (
+    <footer data-wl-admin-credit className="w-full flex-shrink-0 py-4 text-center text-11 text-secondary">
+      Built on Plane Community Edition{" · "}
+      <a href="/source" target="_blank" rel="noopener noreferrer">
+        Source code
+      </a>
+    </footer>
+  );
+}
