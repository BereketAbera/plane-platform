+
+function Waypoint({ x, y, label }: { x: number; y: number; label: string }) {
+  return (
+    <g>
+      <path d={`M${x} ${y - 11}L${x + 11} ${y}L${x} ${y + 11}L${x - 11} ${y}Z`} fill="var(--wl-ink-accent)" />
+      <text x={x + 20} y={y + 4}>
+        {label}
+      </text>
+    </g>
+  );
+}
+
+/** Decorative side of the split-screen sign-in: a route between waypoints over a contour chart. */
+export function RouteChart() {
+  return (
+    <div data-shell="space-art" data-wl-space="auth-art" aria-hidden="true">
+      <svg viewBox="0 0 720 900" preserveAspectRatio="xMidYMid slice" fill="none" focusable="false">
+        {/* Every third contour is heavier, like an index contour on a chart. */}
+        {CONTOURS.map((d, i) => (
+          <path
+            key={d}
+            d={d}
+            stroke={i % 3 === 0 ? "var(--wl-ink-400)" : "var(--wl-ink-500)"}
+            strokeWidth={i % 3 === 0 ? 1.25 : 0.75}
+          />
+        ))}
+        <path d="M133 742L322 548L396 356L575 176" stroke="var(--wl-ink-accent)" strokeWidth="2" strokeDasharray="12 7" />
+        <circle cx="122" cy="754" r="11" stroke="var(--wl-ink-text)" strokeWidth="3" />
+        <text x="142" y="758">
+          WPT 01
+        </text>
+        <Waypoint x={322} y={548} label="WPT 02" />
+        <Waypoint x={396} y={356} label="WPT 03" />
+        <Waypoint x={586} y={165} label="WPT 04" />
+      </svg>
+    </div>
+  );
+}
