      "targets": [
        {
          "expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{container!=\"\",pod!=\"\",namespace=~\"$namespace\"}[2m]))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table"
        },
        {
          "expr": "sum by (namespace, pod) (container_memory_working_set_bytes{container!=\"\",pod!=\"\",namespace=~\"$namespace\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table"
        },
        {
          "expr": "sum by (namespace, pod) (rate(container_cpu_usage_seconds_total{container!=\"\",pod!=\"\",namespace=~\"$namespace\"}[2m])) / sum by (namespace, pod) (kube_pod_container_resource_limits{resource=\"cpu\",namespace=~\"$namespace\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true,
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table"
